<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
      ============================================================
      Wrkzg.Host
      ============================================================
      Type     : Executable (entry point of the entire application)
      Purpose  : Starts Kestrel + the Photino window, bootstraps DI,
                 manages the system tray and the application lifecycle.
      Platform : Windows (win-x64) and macOS (osx-x64, osx-arm64)
      ============================================================
    -->

    <PropertyGroup Label="Output">
        <!--
          WinExe  → no console window on Windows.
          On macOS this setting has no effect –
          there Exe and WinExe behave identically.
        -->
        <OutputType>WinExe</OutputType>
        <AssemblyName>Wrkzg</AssemblyName>
        <RootNamespace>Wrkzg.Host</RootNamespace>
        <!-- Makes the auto-generated Program class visible to test projects -->
        <InternalsVisibleTo>Wrkzg.Api.Tests</InternalsVisibleTo>
    </PropertyGroup>

    <PropertyGroup Label="Publish Targets">
      <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <PropertyGroup Label="Publish Settings">
        <!-- Exclude XML documentation files from publish output -->
        <PublishDocumentationFile>false</PublishDocumentationFile>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
        <!-- Exclude debug symbols from publish -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <PropertyGroup Label="Application Metadata">
        <!-- Shown in the Windows Task Manager and macOS Activity Monitor -->
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
        <Description>Wrkzg – Local Twitch Community Bot</Description>
    </PropertyGroup>

    <PropertyGroup Label="Windows Manifest">
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup Label="Project References">
        <!-- Host only knows the API layer – never Core or Infrastructure directly -->
        <ProjectReference Include="..\Wrkzg.Api\Wrkzg.Api.csproj" />
    </ItemGroup>

    <ItemGroup Label="NuGet Packages">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Photino.NET" />
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Label="Assets">
        <!-- Copy the icon as content — ApplicationIcon only embeds it in the .exe metadata,
             but does not copy the file to the output for SetWindowIcon at runtime -->
        <Content Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
        <None Update="version.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- macOS App Bundle metadata -->
        <None Update="macOS\Info.plist" CopyToOutputDirectory="PreserveNewest" />
        <None Update="macOS\Wrkzg.entitlements" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!--
      On Release builds: build the frontend automatically and copy it into wwwroot.
      On Debug builds, Vite runs separately on port 5173.
    -->
    <Target Name="BuildFrontend"
            BeforeTargets="Build"
            Condition="'$(Configuration)' == 'Release'">
        <Exec Command="npm run build"
              WorkingDirectory="$(MSBuildThisFileDirectory)..\..\src\Wrkzg.Frontend" />
    </Target>

</Project>
