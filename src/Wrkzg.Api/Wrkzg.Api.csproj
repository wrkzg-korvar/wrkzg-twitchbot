<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
      ============================================================
      Wrkzg.Api
      ============================================================
      Type     : Class library with the Web SDK
      Purpose  : REST endpoints (Minimal API), SignalR hubs,
                 static file serving (React SPA from wwwroot).
                 No own entry point – embedded by Host.
      SDK      : Microsoft.NET.Sdk.Web ships ASP.NET Core, Kestrel,
                 and all web middleware.
      ============================================================
    -->

    <PropertyGroup Label="Output">
        <!--
          No <OutputType> → with the Web SDK this defaults to a library.
          Host references this project and provides the entry point.
        -->
        <AssemblyName>Wrkzg.Api</AssemblyName>
        <RootNamespace>Wrkzg.Api</RootNamespace>
        <!-- Declare explicitly as a library – no entry point -->
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <PropertyGroup Label="Dev Proxy">
        <!--
          In Debug mode: pin the Kestrel port to 5050 so the Vite proxy
          (vite.config.ts) always has the correct target address.
        -->
        <SpaProxyLaunchCommand Condition="'$(Configuration)' == 'Debug'">npm run dev</SpaProxyLaunchCommand>
        <SpaProxyServerUrl Condition="'$(Configuration)' == 'Debug'">http://localhost:5173</SpaProxyServerUrl>
    </PropertyGroup>

    <ItemGroup Label="Project References">
        <ProjectReference Include="..\Wrkzg.Core\Wrkzg.Core.csproj" />
        <ProjectReference Include="..\Wrkzg.Infrastructure\Wrkzg.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup Label="NuGet Packages">
        <PackageReference Include="FluentValidation.AspNetCore" />
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Label="wwwroot">
        <!--
          wwwroot is automatically treated as the static-files root by the Web SDK.
          The React build artifacts land here via vite.config.ts (outDir).
          In the repository this folder is empty / gitignored.
        -->
        <Content Update="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\" />
    </ItemGroup>

</Project>
