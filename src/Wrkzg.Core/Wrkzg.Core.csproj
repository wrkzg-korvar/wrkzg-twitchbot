<Project Sdk="Microsoft.NET.Sdk">

    <!--
      ============================================================
      Wrkzg.Core
      ============================================================
      Type     : Class library (standard SDK)
      Purpose  : Business logic, domain models, interfaces,
                 chat games, services – NO framework coupling.
      Rule     : This project may ONLY take the following dependencies:
                 - Microsoft.Extensions.* (abstractions, no concrete framework)
                 - No EF Core, no ASP.NET Core, no Photino
                 Everything else belongs in Infrastructure or Api.
      ============================================================
    -->

    <PropertyGroup Label="Output">
        <AssemblyName>Wrkzg.Core</AssemblyName>
        <RootNamespace>Wrkzg.Core</RootNamespace>

        <!-- Core should expose the most public and most stable API → strict doc requirement -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Label="Analyzer Strictness">
        <!--
          Nullable at the strictest level – Core is the heart of the system,
          there must be no latent NullReferenceException risk here.
        -->
        <Nullable>enable</Nullable>

        <!--
          Enable code analysis with the .NET analyzer ruleset.
          Recommendation: ruleset set to "Recommended" or a custom .editorconfig.
        -->
        <AnalysisLevel>latest-recommended</AnalysisLevel>
    </PropertyGroup>

    <ItemGroup Label="Project References"><!-- Core has NO project references → no outward dependencies -->

      <Folder Include="ChatGames\" />
      <Folder Include="Interfaces\" />
      <Folder Include="Models\" />
      <Folder Include="Services\" />
    </ItemGroup>

    <ItemGroup Label="NuGet Packages">
        <!--
          Abstractions only – no concrete implementations.
          Concrete implementations (e.g. ServiceProvider) come from Infrastructure/Host.
        -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
      Implicitly available via the .NET 10 SDK (no explicit PackageReference needed):
        - Microsoft.Extensions.DependencyInjection.Abstractions
        - Microsoft.Extensions.Logging.Abstractions
        - Microsoft.Extensions.Options
        - Microsoft.Extensions.Hosting.Abstractions
    -->

</Project>