<Project Sdk="Microsoft.NET.Sdk">

    <!--
      ============================================================
      Wrkzg.Updater
      ============================================================
      Type     : Executable – FULLY STAND-ALONE
      Purpose  : Started as a separate process once an update has
                 been downloaded. Waits for the main process to exit,
                 replaces the application files, and restarts the
                 application.
      Important: NO reference to Core, Api, or Infrastructure.
                 The updater must keep working even when the main
                 application is broken.
      ============================================================
    -->

    <PropertyGroup Label="Output">
        <OutputType>Exe</OutputType>
        <!--
          A console window is intentionally allowed here (no WinExe).
          The updater should be visible and show progress to the user.
        -->
        <AssemblyName>Wrkzg.Updater</AssemblyName>
        <RootNamespace>Wrkzg.Updater</RootNamespace>
        <Description>Wrkzg Auto-Updater – replaces application files during update</Description>
    </PropertyGroup>

    <PropertyGroup Label="Publish Targets">
      <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup Label="Project References">
        <!-- Intentionally empty – no dependencies on the main application -->
    </ItemGroup>

    <ItemGroup Label="NuGet Packages">
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
      The updater uses the BCL (Base Class Library) exclusively:
        - System.IO.Compression (ZipFile) → ships with the .NET SDK
        - System.Diagnostics.Process      → ships with the .NET SDK
        - System.Security.Cryptography    → ships with the .NET SDK
      No additional NuGet packages required.
    -->

</Project>
