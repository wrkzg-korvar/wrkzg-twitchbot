<Project Sdk="Microsoft.NET.Sdk">

    <!--
      ============================================================
      Wrkzg.Infrastructure
      ============================================================
      Type     : Class library (standard SDK)
      Purpose  : Concrete implementations of all Core interfaces:
                 - Database access (EF Core + SQLite)
                 - Twitch IRC client (TwitchLib)
                 - Twitch Helix HTTP client
                 - Twitch EventSub WebSocket client
                 - Secure token storage (DPAPI / Keychain)
                 - Repository implementations
      Rule     : Infrastructure implements Core interfaces.
                 Infrastructure knows Core, but neither Api nor Host.
      ============================================================
    -->

    <PropertyGroup Label="Output">
        <AssemblyName>Wrkzg.Infrastructure</AssemblyName>
        <RootNamespace>Wrkzg.Infrastructure</RootNamespace>
    </PropertyGroup>

    <ItemGroup Label="Project References">
        <ProjectReference Include="..\Wrkzg.Core\Wrkzg.Core.csproj" />
    </ItemGroup>

    <ItemGroup Label="Entity Framework Core">
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <!--
          Design package for development only (EF Migrations CLI).
          PrivateAssets=all → NOT propagated to dependent projects
          and does NOT end up in the publish artifact.
        -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Label="Twitch">
        <PackageReference Include="TwitchLib.Client" />
        <PackageReference Include="TwitchLib.Api" />
        <PackageReference Include="TwitchLib.EventSub.Websockets" />
    </ItemGroup>

    <ItemGroup Label="HTTP / Resilience">
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="Polly" />
    </ItemGroup>

    <ItemGroup Label="Source Link">
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
      DPAPI (token encryption) — package is referenced on every
      platform so the code compiles. At runtime DI picks the right
      ISecureStorage implementation via OperatingSystem.IsWindows();
      DPAPI calls in WindowsSecureStorage only run on Windows.
    -->
    <ItemGroup Label="Cryptography">
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    </ItemGroup>



</Project>
