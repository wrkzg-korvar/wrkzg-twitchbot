<Project Sdk="Microsoft.NET.Sdk">

    <!--
      ============================================================
      Wrkzg.Core.Tests
      ============================================================
      Type     : Test project (xUnit)
      Purpose  : Unit tests for all business logic in Core.
                 Mocking via NSubstitute, assertions via FluentAssertions.
      Rule     : No test may require external resources
                 (no DB, no network) – everything is mocked.
      ============================================================
    -->

    <PropertyGroup Label="Output">
        <AssemblyName>Wrkzg.Core.Tests</AssemblyName>
        <RootNamespace>Wrkzg.Core.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <PropertyGroup Label="Test Settings">
        <!--
          Enable parallel test execution – unit tests have no
          shared state and can run in parallel.
        -->
        <ParallelizeTestCollections>true</ParallelizeTestCollections>
    </PropertyGroup>

    <ItemGroup Label="Project Under Test">
        <ProjectReference Include="..\..\src\Wrkzg.Core\Wrkzg.Core.csproj" />
    </ItemGroup>

    <ItemGroup Label="Test Frameworks">
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Label="Test Utilities">
        <!-- DI Container (concrete) needed for IServiceScopeFactory in tests -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />

        <!-- NSubstitute: interface mocking without hand-written mock classes -->
        <PackageReference Include="NSubstitute" />

        <!-- FluentAssertions: readable assertions (should.Be, should.Contain, etc.) -->
        <PackageReference Include="FluentAssertions" />
    </ItemGroup>

</Project>