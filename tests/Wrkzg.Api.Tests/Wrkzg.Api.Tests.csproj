<Project Sdk="Microsoft.NET.Sdk">

    <!--
      ============================================================
      Wrkzg.Api.Tests
      ============================================================
      Type     : Test project (xUnit)
      Purpose  : Integration and unit tests for API endpoints and
                 SignalR hubs. Uses WebApplicationFactory for
                 in-process HTTP tests without a real server.
      ============================================================
    -->

    <PropertyGroup Label="Output">
        <AssemblyName>Wrkzg.Api.Tests</AssemblyName>
        <RootNamespace>Wrkzg.Api.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup Label="Projects Under Test">
        <ProjectReference Include="..\..\src\Wrkzg.Api\Wrkzg.Api.csproj" />
        <ProjectReference Include="..\..\src\Wrkzg.Core\Wrkzg.Core.csproj" />
        <ProjectReference Include="..\..\src\Wrkzg.Infrastructure\Wrkzg.Infrastructure.csproj" />
        <ProjectReference Include="..\..\src\Wrkzg.Host\Wrkzg.Host.csproj" />
    </ItemGroup>

    <ItemGroup Label="Test Frameworks">
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Label="Test Utilities">
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="FluentAssertions" />

        <!--
          WebApplicationFactory: spins up the full ASP.NET Core pipeline
          in-memory for realistic HTTP tests without a real server.
          No network ports are opened.
        -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    </ItemGroup>

</Project>